  <rect x="270" y="520" width="100" height="10" rx="3" fill="#475569"/>
  <rect x="420" y="520" width="150" height="10" rx="3" fill="#475569"/>
  <rect x="620" y="520" width="80" height="10" rx="3" fill="#1c80f5"/>
  <rect x="770" y="520" width="80" height="10" rx="3" fill="#475569"/>
  <rect x="920" y="520" width="80" height="10" rx="3" fill="#2dd4bf"/>
  <rect x="1080" y="515" width="80" height="20" rx="4" fill="#1c80f5" opacity="0.2"/>
  <!-- Export button -->
  <rect x="260" y="620" width="160" height="36" rx="8" fill="url(#accent)"/>
  <text x="640" y="700" font-family="sans-serif" font-size="14" fill="#475569" text-anchor="middle">Planilha de Gestão — Relatórios visuais</text>
</svg>

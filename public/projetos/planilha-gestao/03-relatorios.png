  <rect x="460" y="310" width="12" height="8" rx="2" fill="#fbbf24"/>
  <rect x="480" y="311" width="60" height="6" rx="2" fill="#475569"/>
  <!-- Donut chart -->
  <rect x="760" y="120" width="250" height="200" rx="12" fill="#1e293b"/>
  <rect x="780" y="140" width="140" height="14" rx="4" fill="#475569"/>
  <circle cx="885" cy="230" r="55" fill="none" stroke="#1c80f5" stroke-width="18" stroke-dasharray="130 350"/>
  <circle cx="885" cy="230" r="55" fill="none" stroke="#2dd4bf" stroke-width="18" stroke-dasharray="80 350" stroke-dashoffset="-130"/>
  <circle cx="885" cy="230" r="55" fill="none" stroke="#fbbf24" stroke-width="18" stroke-dasharray="60 350" stroke-dashoffset="-210"/>
  <text x="885" y="235" font-family="monospace" font-size="18" fill="#f1f5f9" text-anchor="middle">100%</text>
  <!-- Summary -->
  <rect x="1030" y="120" width="220" height="200" rx="12" fill="#1e293b"/>
  <rect x="1050" y="140" width="140" height="14" rx="4" fill="#475569"/>
  <rect x="1050" y="170" width="180" height="1" fill="#334155"/>

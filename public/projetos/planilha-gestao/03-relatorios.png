  <rect x="920" y="410" width="100" height="10" rx="3" fill="#59bcff"/>
  <rect x="1080" y="410" width="120" height="10" rx="3" fill="#59bcff"/>
  <rect x="270" y="450" width="100" height="10" rx="3" fill="#475569"/>
  <rect x="420" y="450" width="150" height="10" rx="3" fill="#475569"/>

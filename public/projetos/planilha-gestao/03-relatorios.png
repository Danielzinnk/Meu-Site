  <rect x="260" y="170" width="460" height="130" rx="8" fill="#0d1525"/>
  <polyline points="280,280 340,260 400,240 460,210 520,190 580,200 640,170 700,150" fill="none" stroke="#1c80f5" stroke-width="2"/>
  <polyline points="280,290 340,275 400,270 460,250 520,240 580,230 640,220 700,200" fill="none" stroke="#2dd4bf" stroke-width="2"/>
  <polyline points="280,295 340,290 400,285 460,280 520,270 580,265 640,260 700,250" fill="none" stroke="#fbbf24" stroke-width="2"/>
  <circle cx="700" cy="150" r="4" fill="#1c80f5"/>
  <circle cx="700" cy="200" r="4" fill="#2dd4bf"/>
  <circle cx="700" cy="250" r="4" fill="#fbbf24"/>
  <!-- Legend -->
  <rect x="260" y="310" width="12" height="8" rx="2" fill="#1c80f5"/>
  <rect x="280" y="311" width="60" height="6" rx="2" fill="#475569"/>
  <rect x="360" y="310" width="12" height="8" rx="2" fill="#2dd4bf"/>

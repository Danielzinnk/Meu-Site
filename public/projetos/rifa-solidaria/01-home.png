  <rect x="700" y="110" width="520" height="280" rx="16" fill="#111827"/>
  <rect x="720" y="130" width="480" height="180" rx="12" fill="#1e293b"/>
  <!-- Number grid -->
  <g>
    <rect x="740" y="150" width="40" height="30" rx="4" fill="#1c80f5" opacity="0.4"/>

<svg xmlns="http://www.w3.org/2000/svg" width="1280" height="720" viewBox="0 0 1280 720">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#020617"/>
    </linearGradient>
    <linearGradient id="accent" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#1c80f5"/>
      <stop offset="100%" stop-color="#2dd4bf"/>
    </linearGradient>
    <radialGradient id="spotlight" cx="50%" cy="40%" r="40%">
      <stop offset="0%" stop-color="#1c80f5" stop-opacity="0.15"/>
      <stop offset="100%" stop-color="#1c80f5" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="1280" height="720" fill="url(#bg)"/>
  <rect width="1280" height="720" fill="url(#spotlight)"/>
  <rect x="0" y="0" width="1280" height="72" fill="#111827"/>
  <text x="40" y="46" font-family="monospace" font-size="20" fill="#59bcff" font-weight="bold">Rifa Solidária</text>
  <!-- Center modal -->
  <rect x="290" y="110" width="700" height="520" rx="20" fill="#111827"/>
  <rect x="310" y="130" width="660" height="1" fill="#1e293b"/>
  <text x="640" y="180" font-family="sans-serif" font-size="28" fill="#f1f5f9" text-anchor="middle" font-weight="bold">Sorteio ao vivo</text>
  <rect x="540" y="200" width="200" height="14" rx="4" fill="#475569"/>
  <!-- Number display -->
  <rect x="490" y="240" width="300" height="120" rx="16" fill="#1e293b"/>
  <text x="640" y="320" font-family="monospace" font-size="64" fill="url(#accent)" text-anchor="middle" font-weight="bold">047</text>
  <!-- Spotlight ring -->
  <circle cx="640" cy="300" r="180" fill="none" stroke="#1c80f5" stroke-width="1" opacity="0.2"/>
  <circle cx="640" cy="300" r="140" fill="none" stroke="#2dd4bf" stroke-width="1" opacity="0.15"/>
  <!-- Winner info -->
  <rect x="350" y="390" width="580" height="80" rx="12" fill="#1e293b"/>
  <rect x="370" y="410" width="100" height="12" rx="3" fill="#475569"/>
  <rect x="370" y="435" width="200" height="16" rx="4" fill="#2dd4bf"/>
  <rect x="620" y="410" width="100" height="12" rx="3" fill="#475569"/>
  <rect x="620" y="435" width="180" height="16" rx="4" fill="#59bcff"/>
  <!-- Buttons -->
  <rect x="390" y="510" width="200" height="44" rx="10" fill="url(#accent)"/>
  <rect x="610" y="510" width="200" height="44" rx="10" fill="#1e293b"/>
  <rect x="830" y="510" width="140" height="44" rx="10" fill="#1e293b"/>
  <!-- Side stats -->
  <rect x="60" y="110" width="210" height="120" rx="12" fill="#111827"/>
  <rect x="80" y="130" width="140" height="12" rx="3" fill="#475569"/>
  <rect x="80" y="155" width="60" height="30" rx="4" fill="#2dd4bf"/>
  <rect x="1010" y="110" width="210" height="120" rx="12" fill="#111827"/>
  <rect x="1030" y="130" width="140" height="12" rx="3" fill="#475569"/>
  <rect x="1030" y="155" width="50" height="30" rx="4" fill="#fbbf24"/>
  <rect x="60" y="250" width="210" height="120" rx="12" fill="#111827"/>
  <rect x="80" y="270" width="140" height="12" rx="3" fill="#475569"/>
  <rect x="80" y="295" width="40" height="30" rx="4" fill="#59bcff"/>
  <rect x="1010" y="250" width="210" height="120" rx="12" fill="#111827"/>
  <rect x="1030" y="270" width="140" height="12" rx="3" fill="#475569"/>
  <rect x="1030" y="295" width="70" height="30" rx="4" fill="#1c80f5"/>
  <text x="640" y="700" font-family="sans-serif" font-size="14" fill="#475569" text-anchor="middle">Rifa Solidária — Tela de sorteio</text>
</svg>

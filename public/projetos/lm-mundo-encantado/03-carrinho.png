<svg xmlns="http://www.w3.org/2000/svg" width="1280" height="720" viewBox="0 0 1280 720">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#020617"/>
    </linearGradient>
    <linearGradient id="accent" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#1c80f5"/>
      <stop offset="100%" stop-color="#2dd4bf"/>
    </linearGradient>
  </defs>
  <rect width="1280" height="720" fill="url(#bg)"/>
  <!-- Nav -->
  <rect x="0" y="0" width="1280" height="72" fill="#111827"/>
  <text x="40" y="46" font-family="monospace" font-size="20" fill="#59bcff" font-weight="bold">LM Mundo Encantado</text>
  <rect x="1160" y="20" width="90" height="32" rx="6" fill="url(#accent)"/>
  <!-- Checkout layout -->
  <div></div>
  <!-- Left: cart items -->
  <rect x="60" y="100" width="760" height="580" rx="16" fill="#111827"/>
  <rect x="80" y="120" width="200" height="18" rx="4" fill="#475569"/>
  <rect x="80" y="155" width="720" height="1" fill="#1e293b"/>
  <!-- Item 1 -->
  <rect x="80" y="175" width="720" height="100" rx="12" fill="#1e293b"/>
  <rect x="100" y="195" width="70" height="70" rx="8" fill="#0d1525"/>
  <circle cx="135" cy="230" r="25" fill="#1c80f5" opacity="0.2"/>
  <rect x="190" y="200" width="160" height="14" rx="4" fill="#475569"/>
  <rect x="190" y="225" width="100" height="10" rx="3" fill="#334155"/>
  <rect x="190" y="245" width="80" height="20" rx="4" fill="#1e293b"/>
  <rect x="190" y="248" width="20" height="14" rx="3" fill="#334155"/>
  <rect x="300" y="245" width="24" height="20" rx="4" fill="#334155"/>
  <rect x="700" y="200" width="80" height="14" rx="3" fill="#2dd4bf"/>
  <rect x="720" y="225" width="60" height="24" rx="6" fill="url(#accent)"/>
  <!-- Item 2 -->
  <rect x="80" y="290" width="720" height="100" rx="12" fill="#1e293b"/>
  <rect x="100" y="310" width="70" height="70" rx="8" fill="#0d1525"/>
  <circle cx="135" cy="345" r="25" fill="#fbbf24" opacity="0.2"/>
  <rect x="190" y="315" width="160" height="14" rx="4" fill="#475569"/>
  <rect x="190" y="340" width="100" height="10" rx="3" fill="#334155"/>
  <rect x="190" y="360" width="80" height="20" rx="4" fill="#1e293b"/>
  <rect x="190" y="363" width="20" height="14" rx="3" fill="#334155"/>
  <rect x="300" y="360" width="24" height="20" rx="4" fill="#334155"/>
  <rect x="700" y="315" width="80" height="14" rx="3" fill="#fbbf24"/>
  <rect x="720" y="340" width="60" height="24" rx="6" fill="url(#accent)"/>
  <!-- Item 3 -->
  <rect x="80" y="405" width="720" height="100" rx="12" fill="#1e293b"/>
  <rect x="100" y="425" width="70" height="70" rx="8" fill="#0d1525"/>
  <circle cx="135" cy="460" r="25" fill="#2dd4bf" opacity="0.2"/>
  <rect x="190" y="430" width="160" height="14" rx="4" fill="#475569"/>
  <rect x="190" y="455" width="100" height="10" rx="3" fill="#334155"/>
  <rect x="190" y="475" width="80" height="20" rx="4" fill="#1e293b"/>
  <rect x="190" y="478" width="20" height="14" rx="3" fill="#334155"/>
  <rect x="300" y="475" width="24" height="20" rx="4" fill="#334155"/>
  <rect x="700" y="430" width="80" height="14" rx="3" fill="#59bcff"/>
  <rect x="720" y="455" width="60" height="24" rx="6" fill="url(#accent)"/>
  <!-- Coupon -->
  <rect x="80" y="525" width="300" height="44" rx="10" fill="#1e293b"/>
  <rect x="100" y="535" width="180" height="24" rx="6" fill="#0d1525"/>
  <rect x="300" y="535" width="60" height="24" rx="6" fill="#1e293b"/>
  <!-- Right: summary -->
  <rect x="840" y="100" width="380" height="580" rx="16" fill="#111827"/>
  <rect x="860" y="120" width="160" height="18" rx="4" fill="#475569"/>
  <rect x="860" y="155" width="340" height="1" fill="#1e293b"/>
  <rect x="860" y="175" width="180" height="12" rx="3" fill="#475569"/>
  <rect x="1120" y="175" width="80" height="12" rx="3" fill="#334155"/>
  <rect x="860" y="200" width="180" height="12" rx="3" fill="#475569"/>
  <rect x="1120" y="200" width="80" height="12" rx="3" fill="#334155"/>
  <rect x="860" y="225" width="180" height="12" rx="3" fill="#475569"/>
  <rect x="1120" y="225" width="80" height="12" rx="3" fill="#2dd4bf"/>
  <rect x="860" y="255" width="340" height="1" fill="#1e293b"/>
  <rect x="860" y="275" width="100" height="16" rx="3" fill="#475569"/>
  <rect x="1080" y="273" width="120" height="20" rx="4" fill="url(#accent)"/>
  <!-- Payment methods -->
  <rect x="860" y="320" width="340" height="14" rx="4" fill="#475569"/>
  <rect x="860" y="350" width="80" height="50" rx="8" fill="#1e293b" stroke="#59bcff" stroke-width="1.5"/>
  <rect x="950" y="350" width="80" height="50" rx="8" fill="#1e293b"/>
  <rect x="1040" y="350" width="80" height="50" rx="8" fill="#1e293b"/>
  <rect x="1130" y="350" width="70" height="50" rx="8" fill="#1e293b"/>
  <!-- Checkout button -->
  <rect x="860" y="450" width="340" height="56" rx="12" fill="url(#accent)"/>
  <rect x="860" y="520" width="340" height="44" rx="10" fill="#1e293b"/>
  <rect x="880" y="530" width="200" height="10" rx="3" fill="#475569"/>
  <rect x="880" y="548" width="160" height="10" rx="3" fill="#334155"/>
  <!-- Security -->
  <rect x="860" y="590" width="340" height="60" rx="10" fill="#1e293b"/>
  <rect x="880" y="610" width="24" height="24" rx="4" fill="#2dd4bf" opacity="0.3"/>
  <rect x="920" y="610" width="200" height="10" rx="3" fill="#475569"/>
  <rect x="920" y="630" width="160" height="10" rx="3" fill="#334155"/>
  <text x="640" y="705" font-family="sans-serif" font-size="14" fill="#475569" text-anchor="middle">LM Mundo Encantado — Carrinho e checkout</text>
</svg>

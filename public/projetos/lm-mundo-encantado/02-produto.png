<svg xmlns="http://www.w3.org/2000/svg" width="1280" height="720" viewBox="0 0 1280 720">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#020617"/>
    </linearGradient>
    <linearGradient id="accent" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#1c80f5"/>
      <stop offset="100%" stop-color="#2dd4bf"/>
    </linearGradient>
  </defs>
  <rect width="1280" height="720" fill="url(#bg)"/>
  <!-- Nav -->
  <rect x="0" y="0" width="1280" height="72" fill="#111827"/>
  <text x="40" y="46" font-family="monospace" font-size="20" fill="#59bcff" font-weight="bold">LM Mundo Encantado</text>
  <rect x="1100" y="20" width="40" height="32" rx="6" fill="#1e293b"/>
  <rect x="1160" y="20" width="90" height="32" rx="6" fill="url(#accent)"/>
  <!-- Breadcrumb -->
  <rect x="60" y="90" width="300" height="14" rx="4" fill="#475569"/>
  <!-- Product layout -->
  <!-- Image gallery -->
  <rect x="60" y="120" width="540" height="440" rx="16" fill="#111827"/>
  <rect x="80" y="140" width="500" height="360" rx="12" fill="#1e293b"/>
  <circle cx="330" cy="320" r="120" fill="#1c80f5" opacity="0.12"/>
  <circle cx="330" cy="320" r="80" fill="#2dd4bf" opacity="0.1"/>
  <rect x="250" y="240" width="160" height="160" rx="16" fill="#1e293b"/>
  <!-- Thumbs -->
  <rect x="80" y="510" width="80" height="40" rx="6" fill="#1e293b" stroke="#59bcff" stroke-width="1.5"/>
  <rect x="170" y="510" width="80" height="40" rx="6" fill="#1e293b"/>
  <rect x="260" y="510" width="80" height="40" rx="6" fill="#1e293b"/>
  <rect x="350" y="510" width="80" height="40" rx="6" fill="#1e293b"/>
  <!-- Product info -->
  <rect x="630" y="120" width="590" height="440" rx="16" fill="#111827"/>
  <rect x="650" y="140" width="200" height="14" rx="4" fill="#2dd4bf"/>
  <rect x="650" y="170" width="500" height="34" rx="6" fill="#475569"/>
  <rect x="650" y="220" width="100" height="14" rx="4" fill="#fbbf24"/>
  <!-- Stars -->
  <rect x="650" y="250" width="140" height="12" rx="3" fill="#fbbf24" opacity="0.5"/>
  <rect x="800" y="250" width="80" height="12" rx="3" fill="#475569"/>
  <rect x="650" y="280" width="480" height="12" rx="3" fill="#334155"/>
  <rect x="650" y="300" width="440" height="12" rx="3" fill="#334155"/>
  <rect x="650" y="320" width="460" height="12" rx="3" fill="#334155"/>
  <rect x="650" y="340" width="380" height="12" rx="3" fill="#334155"/>
  <!-- Price -->
  <rect x="650" y="380" width="180" height="40" rx="8" fill="url(#accent)"/>
  <rect x="850" y="380" width="100" height="40" rx="8" fill="#1e293b"/>
  <!-- Quantity + add -->
  <rect x="650" y="440" width="120" height="48" rx="10" fill="#1e293b"/>
  <rect x="650" y="440" width="30" height="48" rx="10" fill="#334155"/>
  <rect x="790" y="440" width="340" height="48" rx="10" fill="url(#accent)"/>
  <!-- Features -->
  <rect x="650" y="510" width="200" height="10" rx="3" fill="#475569"/>
  <rect x="650" y="530" width="180" height="10" rx="3" fill="#334155"/>
  <!-- Related products -->
  <rect x="60" y="580" width="200" height="18" rx="4" fill="#475569"/>
  <rect x="60" y="610" width="270" height="80" rx="10" fill="#111827"/>
  <rect x="80" y="625" width="60" height="50" rx="6" fill="#1e293b"/>
  <rect x="150" y="630" width="140" height="10" rx="3" fill="#475569"/>
  <rect x="150" y="650" width="60" height="10" rx="3" fill="#2dd4bf"/>
  <rect x="350" y="610" width="270" height="80" rx="10" fill="#111827"/>
  <rect x="370" y="625" width="60" height="50" rx="6" fill="#1e293b"/>
  <rect x="440" y="630" width="140" height="10" rx="3" fill="#475569"/>
  <rect x="440" y="650" width="50" height="10" rx="3" fill="#fbbf24"/>
  <rect x="640" y="610" width="270" height="80" rx="10" fill="#111827"/>
  <rect x="660" y="625" width="60" height="50" rx="6" fill="#1e293b"/>
  <rect x="730" y="630" width="140" height="10" rx="3" fill="#475569"/>
  <rect x="730" y="650" width="70" height="10" rx="3" fill="#59bcff"/>
  <rect x="930" y="610" width="290" height="80" rx="10" fill="#111827"/>
  <rect x="950" y="625" width="60" height="50" rx="6" fill="#1e293b"/>
  <rect x="1020" y="630" width="140" height="10" rx="3" fill="#475569"/>
  <rect x="1020" y="650" width="60" height="10" rx="3" fill="#2dd4bf"/>
  <text x="640" y="705" font-family="sans-serif" font-size="14" fill="#475569" text-anchor="middle">LM Mundo Encantado — Página de produto</text>
</svg>

<svg xmlns="http://www.w3.org/2000/svg" width="1280" height="720" viewBox="0 0 1280 720">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#020617"/>
    </linearGradient>
    <linearGradient id="accent" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#1c80f5"/>
      <stop offset="100%" stop-color="#2dd4bf"/>
    </linearGradient>
  </defs>
  <rect width="1280" height="720" fill="url(#bg)"/>
  <!-- Nav -->
  <rect x="0" y="0" width="1280" height="72" fill="#111827"/>
  <text x="40" y="46" font-family="monospace" font-size="20" fill="#59bcff" font-weight="bold">LM Mundo Encantado</text>
  <rect x="500" y="24" width="100" height="24" rx="6" fill="#1e293b"/>
  <rect x="620" y="24" width="100" height="24" rx="6" fill="#1e293b"/>
  <rect x="740" y="24" width="100" height="24" rx="6" fill="#1e293b"/>
  <rect x="1100" y="20" width="40" height="32" rx="6" fill="#1e293b"/>
  <rect x="1160" y="20" width="90" height="32" rx="6" fill="url(#accent)"/>
  <!-- Hero -->
  <rect x="0" y="72" width="1280" height="360" fill="#0d1525"/>
  <rect x="60" y="120" width="500" height="260" rx="16" fill="#111827"/>
  <rect x="90" y="150" width="160" height="14" rx="4" fill="#2dd4bf"/>
  <rect x="90" y="180" width="420" height="34" rx="6" fill="#475569"/>
  <rect x="90" y="230" width="380" height="16" rx="4" fill="#334155"/>
  <rect x="90" y="256" width="340" height="16" rx="4" fill="#334155"/>
  <rect x="90" y="300" width="140" height="40" rx="8" fill="url(#accent)"/>
  <rect x="250" y="300" width="140" height="40" rx="8" fill="#1e293b"/>
  <!-- Hero product image -->
  <rect x="600" y="110" width="620" height="300" rx="16" fill="#1e293b"/>
  <circle cx="910" cy="260" r="100" fill="#1c80f5" opacity="0.15"/>
  <circle cx="910" cy="260" r="70" fill="#2dd4bf" opacity="0.1"/>
  <rect x="830" y="200" width="160" height="120" rx="12" fill="#1e293b"/>
  <!-- Product grid -->
  <rect x="60" y="460" width="200" height="20" rx="4" fill="#475569"/>
  <rect x="60" y="490" width="1160" height="1" fill="#1e293b"/>
  <!-- Product cards -->
  <rect x="60" y="510" width="270" height="180" rx="12" fill="#111827"/>
  <rect x="80" y="530" width="230" height="100" rx="8" fill="#1e293b"/>
  <circle cx="195" cy="580" r="35" fill="#fbbf24" opacity="0.2"/>
  <rect x="80" y="645" width="140" height="12" rx="3" fill="#475569"/>
  <rect x="80" y="665" width="60" height="14" rx="3" fill="#2dd4bf"/>
  <rect x="240" y="660" width="70" height="22" rx="6" fill="url(#accent)"/>
  <rect x="350" y="510" width="270" height="180" rx="12" fill="#111827"/>
  <rect x="370" y="530" width="230" height="100" rx="8" fill="#1e293b"/>
  <circle cx="485" cy="580" r="35" fill="#1c80f5" opacity="0.2"/>
  <rect x="370" y="645" width="140" height="12" rx="3" fill="#475569"/>
  <rect x="370" y="665" width="50" height="14" rx="3" fill="#fbbf24"/>
  <rect x="530" y="660" width="70" height="22" rx="6" fill="url(#accent)"/>
  <rect x="640" y="510" width="270" height="180" rx="12" fill="#111827"/>
  <rect x="660" y="530" width="230" height="100" rx="8" fill="#1e293b"/>
  <circle cx="775" cy="580" r="35" fill="#2dd4bf" opacity="0.2"/>
  <rect x="660" y="645" width="140" height="12" rx="3" fill="#475569"/>
  <rect x="660" y="665" width="70" height="14" rx="3" fill="#59bcff"/>
  <rect x="820" y="660" width="70" height="22" rx="6" fill="url(#accent)"/>
  <rect x="930" y="510" width="290" height="180" rx="12" fill="#111827"/>
  <rect x="950" y="530" width="250" height="100" rx="8" fill="#1e293b"/>
  <circle cx="1075" cy="580" r="35" fill="#fbbf24" opacity="0.2"/>
  <rect x="950" y="645" width="140" height="12" rx="3" fill="#475569"/>
  <rect x="950" y="665" width="60" height="14" rx="3" fill="#2dd4bf"/>
  <rect x="1130" y="660" width="70" height="22" rx="6" fill="url(#accent)"/>
  <text x="640" y="705" font-family="sans-serif" font-size="14" fill="#475569" text-anchor="middle">LM Mundo Encantado — Página inicial</text>
</svg>
